# wmcp-jepa-service (zawarudo) environment template.
# Copy to .env and fill real values locally. .env is git-ignored — never commit secrets.

# Hugging Face token: download the quentinll/lewm-pusht checkpoint and run HF Jobs.
# Needed only to build the real model package / run the real (lewm) backend.
HF_TOKEN=

# --- Service configuration (read by src/wmcp_jepa_service/server.py) ---
WMCP_MODEL_ID=lewm-pusht
# backend: mock (default, no weights) | lewm (real LeWorldModel; needs a built model package)
WMCP_BACKEND=mock
WMCP_LOG_LEVEL=INFO
WMCP_ENABLE_PROMETHEUS=true
# OTLP collector endpoint (docker compose sets this to the in-network collector).
# WMCP_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Demo client (src client/) ---
WMCP_BASE_URL=http://localhost:8080

# --- docker compose demo overrides ---
# Host dir of the built model package mounted at /models/lewm-pusht for the lewm backend.
# WMCP_MODEL_PACKAGE_DIR=../.artifacts/model-package/lewm-pusht
